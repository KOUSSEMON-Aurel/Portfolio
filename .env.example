# Configuration EmailJS pour l'envoi d'emails
# Obtenez ces clés sur https://www.emailjs.com/

# Votre Service ID (trouvé dans Email Services)
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# Votre Template ID (trouvé dans Email Templates)
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here

# Votre Public Key (trouvé dans Account → General)
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Email de destination
VITE_CONTACT_EMAIL=contact@alexdubois.dev